{
  "_meta": {
    "descripcion": "Pipeline de HeyGen: crear video con avatar → esperar → poll status",
    "sprint_origen": "Sprint 02 / Sprint 03",
    "nodos": 3,
    "uso": "Generar un video con avatar HeyGen y esperar a que esté listo"
  },
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v2/video/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "={{ $json.heygen_api_key }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_inputs\": [{\n    \"character\": {\n      \"type\": \"avatar\",\n      \"avatar_id\": \"{{ $json.avatar_id }}\",\n      \"avatar_style\": \"normal\"\n    },\n    \"voice\": {\n      \"type\": \"text\",\n      \"input_text\": \"{{ $json.script_video }}\",\n      \"voice_id\": \"{{ $json.voice_id }}\"\n    },\n    \"background\": {\n      \"type\": \"color\",\n      \"value\": \"#FFFFFF\"\n    }\n  }],\n  \"dimension\": {\n    \"width\": 720,\n    \"height\": 1280\n  },\n  \"test\": false,\n  \"caption\": false\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0],
      "name": "HeyGen: Create Video (v2)"
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [300, 0],
      "name": "Wait 5 min"
    },
    {
      "parameters": {
        "url": "=https://api.heygen.com/v1/video_status.get?video_id={{ $json.data.video_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "={{ $json.heygen_api_key }}" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 0],
      "name": "HeyGen: Poll Status (v1)"
    }
  ],
  "connections": {
    "HeyGen: Create Video (v2)": {
      "main": [[{ "node": "Wait 5 min", "type": "main", "index": 0 }]]
    },
    "Wait 5 min": {
      "main": [[{ "node": "HeyGen: Poll Status (v1)", "type": "main", "index": 0 }]]
    }
  }
}
