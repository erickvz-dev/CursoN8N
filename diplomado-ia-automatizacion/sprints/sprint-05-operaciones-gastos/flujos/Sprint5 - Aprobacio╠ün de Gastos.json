        }
      }
    },
    {
      "parameters": {
        "jsCode": "const callback = $json.callback_query;\nconst callbackId = callback.id;\nconst chatId = callback.message.chat.id;\nconst data = callback.data; // \"aprobar_42\" o \"rechazar_42\"\n\nconst separador = data.indexOf(\"_\");\nconst accion = data.substring(0, separador);\nconst registroId = parseInt(data.substring(separador + 1));\n\nconst estado = accion === \"aprobar\" ? \"Aprobado\" : \"Rechazado\";\nconst emoji = accion === \"aprobar\" ? \"✅\" : \"❌\";\n\nreturn [{\n  json: {\n    callback_id: callbackId,\n    chat_id: chatId.toString(),\n    registro_id: registroId,\n    estado: estado,\n    mensaje: `${emoji} Gasto #${registroId} ha sido ${estado}.`\n  }\n}];"
      },
      "id": "8c408f70-52cd-4ff2-ab6a-1a4e3dd5fd1a",
      "name": "02 - Code Extraer Accion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        64
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE \"Gastos\" SET \"estado\" = '{{ $json.estado }}' WHERE id = {{ $json.registro_id }} RETURNING *",
        "options": {}
      },
      "id": "0086e925-3d02-4ad1-a3f4-629b18263fdf",
      "name": "03 - Postgres Update Estado",
      "type": "n8n-nodes-base.postgres",
