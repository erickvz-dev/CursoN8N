    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "GPT-4O"
        },
        "text": "=Analiza esta imagen de un ticket de gasto y extrae la siguiente información:\n\n- fecha: en formato DD/MM/YYYY\n- empleado: nombre completo (usa \"{{ $('01 - Telegram Trigger').item.json.message.from.first_name }} {{ $('01 - Telegram Trigger').item.json.message.from.last_name }}\" si no está en el ticket)\n- monto: valor numérico con 2 decimales\n- categoria: debe ser una de estas opciones: \"comida\", \"transporte\", \"materiales\", \"otro\"\n\nResponde ÚNICAMENTE con un objeto JSON válido sin markdown:\n{\"fecha\":\"DD/MM/YYYY\",\"empleado\":\"Nombre Completo\",\"monto\":0.00,\"categoria\":\"comida\"}\n\nSi no puedes leer la imagen claramente, responde:\n{\"error\":\"no_legible\"}",
        "inputType": "base64",
        "options": {
          "maxTokens": 300
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [
        496,
        1120
      ],
      "id": "90f3c692-010c-494a-b95d-4edebf50edfb",
      "name": "05 - OpenAI Vision",
      "credentials": {
        "openAiApi": {
          "id": "SNcq9lmxwYGcZb6e",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "try {\n  const trigger = $('01 - Telegram Trigger').item.json;\n  const chatId = trigger.message?.chat?.id?.toString() || null;\n  const response = $input.first()?.json ?? {};\n\n  const fail = (msg = \"❌ No pude leer la imagen. Por favor intenta con otra foto más clara del ticket.\") => [\n    { json: { ok: false, chat_id: chatId, error_message: msg } }\n  ];\n\n  let data;\n\n  // Caso 1: El nodo OpenAI devolvió los campos directamente como JSON\n  if (response.fecha || response.monto || response.empleado || response.categoria) {\n    data = response;\n  } else {\n    // Caso 2: La respuesta viene como texto que hay que extraer y parsear\n    const extractText = (payload) => {\n      if (!payload) return null;\n      if (typeof payload === \"string\") return payload;\n      if (payload.choices?.[0]?.message?.content) return payload.choices[0].message.content;\n      if (Array.isArray(payload.output)) {\n        for (const item of payload.output) {\n          if (item?.type === \"message\" && Array.isArray(item.content)) {\n            const textChunk = item.content.find((c) => c?.type === \"output_text\");\n            if (textChunk?.text) return textChunk.text;\n          }\n        }\n      }\n      if (payload.message?.content) return payload.message.content;\n      if (payload.content) return payload.content;\n      if (payload.text) return payload.text;\n      return null;\n    };\n\n    let rawText = extractText(response);\n    if (!rawText) return fail();\n    rawText = String(rawText).trim().replace(/^\\s*```(?:json)?\\s*/i, \"\").replace(/\\s*```\\s*$/i, \"\").trim();\n\n    try {\n      data = typeof rawText === \"string\" ? JSON.parse(rawText) : rawText;\n    } catch (e) {\n      return fail(\"❌ No pude procesar la respuesta. Intenta con otra foto más clara.\");\n    }\n  }\n\n  if (!data || typeof data !== \"object\") return fail();\n  if (data.error === \"no_legible\") return fail();\n\n  const fecha = (data.fecha ?? \"\").toString().trim();\n  const empleado = (data.empleado ?? \"\").toString().trim();\n  const monto = parseFloat(data.monto);\n  let categoria = (data.categoria ?? \"\").toString().trim().toLowerCase();\n  const categoriasValidas = [\"comida\", \"transporte\", \"materiales\", \"otro\"];\n  if (!categoriasValidas.includes(categoria)) categoria = \"otro\";\n\n  const fechaValida = /^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/.test(fecha);\n  if (!fechaValida || !empleado || !Number.isFinite(monto) || monto <= 0) {\n    return fail(\"❌ Datos incompletos en el ticket. Verifica que se vean claramente: fecha, monto y categoría.\");\n  }\n\n  return [{\n    json: {\n      ok: true,\n      chat_id: chatId,\n      Fecha: fecha,\n      Empleado: empleado,\n      Monto: monto,\n      Categoria: categoria,\n      Estado: \"Pendiente\"\n    }\n  }];\n} catch (e) {\n  const fallbackChatId = $('01 - Telegram Trigger').item.json.message?.chat?.id?.toString() || null;\n  return [{\n    json: {\n      ok: false,\n      chat_id: fallbackChatId,\n      error_message: \"❌ Error procesando la imagen. Por favor intenta nuevamente.\"\n    }\n  }];\n}"
      },
