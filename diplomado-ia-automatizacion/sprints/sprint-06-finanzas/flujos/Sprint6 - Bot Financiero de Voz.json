                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH params AS (\n  SELECT \u0027{{ $json.periodo }}\u0027::text AS periodo\n),\nbase_date AS (\n  SELECT GREATEST(\n    COALESCE((SELECT MAX(\"Transacciones\".fecha) FROM \"Transacciones\"), DATE \u00272000-01-01\u0027),\n    COALESCE((SELECT MAX(\"Gastos\".created_at::date) FROM \"Gastos\"), DATE \u00272000-01-01\u0027)\n  ) AS ref_date\n),\nrango AS (\n  SELECT\n    CASE\n      WHEN p.periodo = \u0027semana\u0027 THEN (b.ref_date - INTERVAL \u00276 days\u0027)::date\n      WHEN p.periodo = \u0027mes\u0027 THEN (b.ref_date - INTERVAL \u00271 month\u0027 + INTERVAL \u00271 day\u0027)::date\n      ELSE (b.ref_date - INTERVAL \u00271 year\u0027 + INTERVAL \u00271 day\u0027)::date\n    END AS fecha_inicio,\n    b.ref_date AS fecha_fin\n  FROM params p\n  CROSS JOIN base_date b\n)\n\nSELECT\n  \u0027gastos\u0027 AS fuente,\n  \"Gastos\".categoria,\n  \"Gastos\".estado AS detalle,\n  COUNT(*) AS total,\n  SUM(\"Gastos\".monto)::numeric AS suma\nFROM \"Gastos\"\nCROSS JOIN rango\nWHERE \"Gastos\".created_at::date \u003e= rango.fecha_inicio\n  AND \"Gastos\".created_at::date \u003c= rango.fecha_fin\nGROUP BY \"Gastos\".categoria, \"Gastos\".estado\n\nUNION ALL\n\nSELECT\n  \u0027transacciones\u0027 AS fuente,\n  \"Transacciones\".categoria,\n  \"Transacciones\".tipo AS detalle,\n  COUNT(*) AS total,\n  SUM(\"Transacciones\".monto)::numeric AS suma\nFROM \"Transacciones\"\nCROSS JOIN rango\nWHERE \"Transacciones\".fecha \u003e= rango.fecha_inicio\n  AND \"Transacciones\".fecha \u003c= rango.fecha_fin\nGROUP BY \"Transacciones\".categoria, \"Transacciones\".tipo\n\nORDER BY fuente, suma DESC;",
                                         "options":  {

                                                     }
                                     },
                      "type":  "n8n-nodes-base.postgres",
                      "typeVersion":  2.5,
                      "position":  [
