                                         "jsCode":  "const pregunta = $input.first().json.pregunta.toLowerCase();\n\n// Detectar intenciÃ³n temporal\nlet periodo = \u0027anio\u0027;\nif (\n  pregunta.includes(\u0027Ãºltima semana\u0027) ||\n  pregunta.includes(\u0027ultima semana\u0027) ||\n  pregunta.includes(\u0027esta semana\u0027) ||\n  pregunta.includes(\u0027semana pasada\u0027)\n) {\n  periodo = \u0027semana\u0027;\n} else if (\n  pregunta.includes(\u0027Ãºltimo mes\u0027) ||\n  pregunta.includes(\u0027ultimo mes\u0027) ||\n  pregunta.includes(\u0027este mes\u0027) ||\n  pregunta.includes(\u0027mes pasado\u0027)\n) {\n  periodo = \u0027mes\u0027;\n}\n\n// Reglas:\n// - semana =\u003e Ãºltimos 7 dÃ­as\n// - mes =\u003e Ãºltimo mes\n// - default =\u003e Ãºltimo aÃ±o\nreturn [\n  {\n    json: {\n      ...$input.first(),\n      periodo\n    }\n  }\n];"
