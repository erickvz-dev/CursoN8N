        "jsonOutput": "{\n  \"negocio\": \"Cafetería Nube\",\n  \"contexto\": \"TODO: pega aquí el contexto (ubicación, propuesta de valor, audiencia, tono de marca, horarios, productos estrella, etc.)\",\n  \"cantidad_posts\": 3,\n  \"cantidad_stories\": 2,\n  \"cantidad_reels\": 2,\n  \"promos_semana\": \"Martes 2x1 en capuccino, Jueves panqué recién horneado, Sábado bebidas frías 10% off\"\n}",
        "options": {}
      },
