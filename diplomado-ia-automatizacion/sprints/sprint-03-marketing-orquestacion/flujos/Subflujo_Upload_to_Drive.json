        "jsCode": "const response = $input.first().json;\n\nconst jobId = response?.job?.id;\nif (!jobId) {\n  throw new Error('Canva export no devolvió job.id: ' + JSON.stringify(response));\n}\n\nreturn {\n  json: {\n    ...response,\n    export_job_id: jobId,\n    _state: {\n      attempts: 0,\n      maxAttempts: 30\n    }\n  }\n};"
