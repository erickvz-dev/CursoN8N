    },
    {
      "parameters": {
        "jsCode": "const originalInput = $node['When Executed by Another Workflow'].json;\nconst payload = $input.first().json;\nconst d = payload?.data ?? payload;\n\nconst urls = [];\nconst walk = (val) => {\n  if (!val) return;\n  if (typeof val === 'string') {\n    if (/^https?:\\/\\//i.test(val)) urls.push(val);\n    return;\n  }\n  if (Array.isArray(val)) {\n    for (const v of val) walk(v);\n    return;\n  }\n  if (typeof val === 'object') {\n    for (const v of Object.values(val)) walk(v);\n  }\n};\nwalk(d);\n\nconst best =\n  urls.find((u) => /\\.mp4(\\?|$)/i.test(u)) ||\n  d?.video_url ||\n  d?.url ||\n  originalInput.url ||\n  '';\n\nif (!best) {\n  throw new Error('HeyGen no devolvió URL de descarga. Verifica video_id y API key.');\n}\n\nreturn {\n  json: {\n    ...originalInput,\n    heygen_status_payload: payload,\n    resolved_url: best,\n    url: best\n  }\n};\n"
      },
