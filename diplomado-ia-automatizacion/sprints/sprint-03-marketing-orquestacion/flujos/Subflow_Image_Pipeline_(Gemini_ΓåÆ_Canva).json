      "parameters": {
        "jsCode": "const prev = $input.first().json;\n\n// Normaliza respuesta: a veces viene {job:{...}} o {data:{...}}\nconst job = prev.job ?? prev.data?.job ?? prev.data ?? prev;\n\nconst status = job?.status;\nconst assetId = job?.asset?.id;\n\nreturn {\n  json: {\n    ...prev,\n    _poll: {\n      status: status || 'unknown',\n      asset_id: assetId || ''\n    }\n  }\n};\n"
      },
