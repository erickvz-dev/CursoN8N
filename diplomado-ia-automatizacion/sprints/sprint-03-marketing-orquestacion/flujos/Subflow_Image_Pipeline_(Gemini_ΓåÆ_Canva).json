        "jsCode": "const base = $input.first().json;\n\nconst jobId = base?.job?.id;\nif (!jobId) throw new Error('Canva upload no devolvió job.id');\n\nreturn {\n  json: {\n    ...base,\n    canva_job_id: jobId,\n  }\n};\n"
