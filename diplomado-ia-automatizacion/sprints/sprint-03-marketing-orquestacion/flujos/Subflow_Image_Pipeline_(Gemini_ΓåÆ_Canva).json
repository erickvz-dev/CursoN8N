      "parameters": {
        "jsCode": "const originalInput = $('When Executed by Another Workflow').first().json;\n\n// Normaliza respuesta de Canva designs\nconst designId = $input.first().json.design.id;\nconst editUrl = $input.first().json.design.urls.edit_url;\n\n// CRÍTICO: Mantener TODO el contexto original + agregar resultados de Canva\nreturn {\n  json: {\n    ...originalInput,\n    success: true,\n    status: 'success',\n    canva_job_id: $('Canva: Poll Upload Job').first().json.job.id,\n    canva_asset_id: $('Canva: Poll Upload Job').first().json.job.asset.id,\n    canva_design_id: designId,\n    canva_edit_url: editUrl,\n    canva_export_url: editUrl,\n    image_url: editUrl,\n    filename: $('Canva: Poll Upload Job').first().json.job.asset.name\n  }\n};\n"
