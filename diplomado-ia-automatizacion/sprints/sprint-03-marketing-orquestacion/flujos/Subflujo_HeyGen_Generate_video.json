      "id": "deccd100-3cba-4bc3-ba43-abb427d62312",
      "name": "Set: HeyGen Config (avatar/voice)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -2400,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\n\n// Control de loop\nconst maxAttempts = 36; // 36 * 10s ~ 6 min\n\n// Dimensiones segun aspect_ratio\n// NOTA: HeyGen free tier requiere 720p max (no 1080p)\nconst ar = (j.aspect_ratio || '9:16').trim();\nlet width = 720;\nlet height = 1280;\n\nif (ar === '1:1') {\n  width = 720;\n  height = 720;\n} else if (ar === '16:9') {\n  width = 1280;\n  height = 720;\n} else {\n  // default 9:16\n  width = 720;\n  height = 1280;\n}\n\nreturn {\n  json: {\n    ...j,\n    _state: {\n      attempts: 0,\n      maxAttempts,\n      width,\n      height\n    }\n  }\n};\n"
      },
      "id": "b9d60cb0-f0ca-4da6-b4bd-656f684f40ee",
      "name": "Code: Init State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2176,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v2/video/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $('Set: HeyGen Config (avatar/voice)').item.json.heygen_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_inputs\": [\n    {\n      \"character\": {\n        \"type\": \"avatar\",\n        \"avatar_id\": \"{{ $json.avatar_id }}\",\n        \"avatar_style\": \"normal\"\n      },\n      \"voice\": {\n        \"type\": \"text\",\n        \"input_text\": \"{{ $('When Executed by Another Workflow').item.json.script_video }}\",\n        \"voice_id\": \"{{ $json.voice_id }}\"\n      },\n      \"background\": {\n        \"type\": \"color\",\n        \"value\": \"#FFFFFF\"\n      }\n    }\n  ],\n  \"dimension\": {\n    \"width\": {{ $json._state.width }},\n    \"height\": {{ $json._state.height }}\n  },\n  \"test\": false,\n  \"caption\": false\n}\n",
        "options": {}
      },
      "id": "b2c5f164-1348-4b95-89b1-73fd015c0f2f",
      "name": "HeyGen: Create Video (v2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1952,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\n\n// HeyGen suele responder con { data: { video_id } }\nconst videoId = $input.first().json.data.video_id;\n\nif (!videoId) {\n  throw new Error('HeyGen create video no devolvió video_id (revisa credenciales/body).');\n}\n\nreturn {\n  json: {\n    ...res,\n    video_id: videoId\n  }\n};\n"
      },
      "id": "07044f65-8d03-4616-8eaa-daf9ac6eb89e",
      "name": "Code: Store video_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1728,
        -80
      ]
    },
    {
      "parameters": {
        "url": "=https://api.heygen.com/v1/video_status.get?video_id={{ $('Code: Store video_id').item.json.data.video_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $('Code: Init State').item.json.heygen_api_key }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fc7aa594-19b7-4d63-b9e1-eeaa47f70f8b",
      "name": "HeyGen: Poll Status (v1)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1280,
        -144
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst d = data?.data ?? data;\n\nconst status = String(d?.status ?? d?.video_status ?? 'unknown').toLowerCase();\n\nconst collected = [];\nconst walk = (val) => {\n  if (!val) return;\n  if (typeof val === 'string') {\n    if (/^https?:\\/\\//i.test(val)) collected.push(val);\n    return;\n  }\n  if (Array.isArray(val)) {\n    for (const v of val) walk(v);\n    return;\n  }\n  if (typeof val === 'object') {\n    for (const v of Object.values(val)) walk(v);\n  }\n};\nwalk(d);\n\nconst directVideoUrl =\n  collected.find((u) => /\\.mp4(\\?|$)/i.test(u)) ||\n  d?.video_url ||\n  d?.url ||\n  '';\n\nconst shareUrl = collected.find((u) => /heygen\\.com\\/video\\//i.test(u)) || '';\n\nreturn {\n  json: {\n    ...data,\n    _poll: {\n      status: status || 'unknown',\n      video_url: directVideoUrl,\n      share_url: shareUrl\n    }\n  }\n};\n"
      },
      "id": "3cbb5854-6d0a-46a1-aaa3-0cb042decd73",
      "name": "Code: Normalize Poll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1056,
        -144
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json._poll.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "id": "fb344d1f-f86f-4c3d-bdae-24b94c75f17f"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "df4e6c20-d89f-4945-b322-cba61659931a",
      "name": "IF: Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
