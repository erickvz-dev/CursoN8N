      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst originalInput = $node[\"When Executed by Another Workflow\"].json;\n\nreturn {\n  json: {\n    ...originalInput,\n    success: false,\n    status: 'timeout',\n    video_id: j.video_id || '',\n    error: `HeyGen no completó tras ${j._state?.maxAttempts ?? 36} intentos`,\n    raw: { poll: j }\n  }\n};\n"
      },
      "id": "9cc58b83-c8ea-43b8-8bbc-d25b3e28adff",
