            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $('Code: Normalize Poll').item.json.data.status }}",
              "rightValue": "processing",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "id": "476d539b-176f-4b6f-bb49-459481fe1ac0"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "31d4e0e0-1978-49db-9448-c188b95d2210",
      "name": "IF: Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -608,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst attempts = (j._state?.attempts ?? 0) + 1;\n\nreturn {\n  json: {\n    ...j,\n    _state: {\n      ...j._state,\n      attempts\n    }\n  }\n};\n"
      },
      "id": "4b884871-8aea-44b0-91ef-2278d8574039",
      "name": "Code: attempts++",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
        48
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json._state.attempts }}",
              "rightValue": "={{ $json._state.maxAttempts }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "d2ddc83b-a624-421a-bf5c-cd519588bcff",
      "name": "IF: attempts < maxAttempts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -160,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst originalInput = $node[\"When Executed by Another Workflow\"].json;\n\nreturn {\n  json: {\n    ...originalInput,\n    success: true,\n    status: 'completed',\n    heygen_video_id: j.video_id || j.data?.video_id || '',\n    heygen_video_url: j._poll?.video_url || '',\n    heygen_share_url: j._poll?.share_url || '',\n    heygen_api_key: $node[\"Set: HeyGen Config (avatar/voice)\"].json.heygen_api_key || '',\n    video_url: j._poll?.video_url || ''\n  }\n};\n"
      },
      "id": "c033297c-7251-4fe1-b58e-2cd5c5cb85b5",
      "name": "Code: Output Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        -240
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst originalInput = $node[\"When Executed by Another Workflow\"].json;\n\nreturn {\n  json: {\n    ...originalInput,\n    success: false,\n    status: 'failed',\n    video_id: j.video_id || '',\n    error: 'HeyGen devolvió status=failed',\n    raw: { poll: j }\n  }\n};\n"
      },
      "id": "c6154c46-3fe8-402f-8c93-e0fe34967b63",
      "name": "Code: Output Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
