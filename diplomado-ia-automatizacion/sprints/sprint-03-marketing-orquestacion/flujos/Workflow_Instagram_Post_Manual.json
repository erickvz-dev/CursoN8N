      "id": "set-post-data",
      "name": "Set: Datos del Post",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        464,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "// Limpiar y proxy URL de Drive\nconst input = $input.item.json;\nconst url = (input.asset_url || '').toString();\nconst base = (input.file_proxy_base_url || '').toString().trim();\nlet cleanUrl = url;\n\nconst canUseProxyBase = base.length > 0 && !base.includes('TU_') && /^https?:\\/\\//.test(base);\n\n// Si es Google Drive y tenemos base URL configurada, convertir a Proxy\nif (url && url.includes('drive.google.com') && canUseProxyBase) {\n  const idFromPath = url.match(/\\/d\\/([a-zA-Z0-9_-]{10,})/);\n  const idFromQuery = url.match(/[?&]id=([a-zA-Z0-9_-]{10,})/);\n  const idFallback = url.match(/[-\\w]{25,}/);\n  const fileId = (idFromPath && idFromPath[1]) || (idFromQuery && idFromQuery[1]) || (idFallback && idFallback[0]) || '';\n\n  if (fileId) {\n    const cleanBase = base.replace(/\\/$/, '');\n    cleanUrl = `${cleanBase}/webhook/file-proxy?file_id=${fileId}`;\n  }\n}\n\nreturn {\n  json: {\n    ...input,\n    asset_url: cleanUrl,\n    original_url: url\n  }\n};"
      },
