      "parameters": {
        "jsCode": "const allRows = $('Read: Existing Sheet Data').all();\nconst inputItems = $('When Executed by Another Workflow').all();\nconst now = new Date().toISOString();\n\nreturn inputItems.map(inputItem => {\n  const id = inputItem.json.id;\n  const updates = inputItem.json.updates ?? {};\n\n  if (!id || typeof id !== 'string') {\n    throw new Error('Update Sheet: input.id es requerido y debe ser string');\n  }\n\n  // Buscar fila existente en el Sheet\n  const existingRow = allRows.find(r => r.json.id === id);\n  \n  // Merge: datos existentes + updates nuevos\n  const mergedRow = {\n    ...(existingRow?.json || {}),\n    ...updates,\n    id: id,\n    updated_at: now\n  };\n\n  return { json: mergedRow };\n});\n"
      },
