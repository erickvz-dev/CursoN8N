        "jsCode": "// CRÍTICO: Devolver toda la data del item original + confirmación de actualización\nconst originalInput = $node[\"When Executed by Another Workflow\"].json;\nconst sheetResult = $input.first().json;\n\n// Merge: data original + updates aplicados + confirmación\nconst output = {\n  ...originalInput,\n  ...originalInput.updates,\n  success: true,\n  sheet_updated: true,\n  updated_at: new Date().toISOString()\n};\n\n// Limpiar el objeto 'updates' anidado para evitar confusión\ndelete output.updates;\n\nreturn { json: output };"
