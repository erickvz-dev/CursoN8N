    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst original = $node[\"When Executed by Another Workflow\"].json;\n\nconst isErr = !!input?.error || !!input?.message?.error || (typeof input?.statusCode === 'number' && input.statusCode >= 400);\n\nreturn {\n  json: {\n    success: !isErr,\n    id: original.id,\n    tipo: original.tipo,\n    ig_user_id: original.ig_user_id,\n    final_asset_url: original.final_asset_url,\n    caption: original.caption || '',\n    instagram_response: input,\n    error: isErr ? (input?.error?.message || input?.message?.error || 'Instagram publish failed') : ''\n  }\n};\n"
      },
      "id": "16deb95e-8bdc-4bea-a898-a0befbbda015",
      "name": "Return: Normalize Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst originalUrl = (input.final_asset_url || '').toString().trim();\nconst base = (input.file_proxy_base_url || '').toString().trim();\n\nlet finalUrl = originalUrl;\n\nconst canUseProxyBase = base.length > 0 && !base.includes('TU_') && /^https?:\\/\\//.test(base);\nconst isDriveUrl = originalUrl.includes('drive.google.com');\n\nif (isDriveUrl && canUseProxyBase) {\n  const idFromPath = originalUrl.match(/\\/d\\/([a-zA-Z0-9_-]{10,})/);\n  const idFromQuery = originalUrl.match(/[?&]id=([a-zA-Z0-9_-]{10,})/);\n  const idFallback = originalUrl.match(/[-\\w]{25,}/);\n\n  const fileId = (idFromPath && idFromPath[1]) || (idFromQuery && idFromQuery[1]) || (idFallback && idFallback[0]) || '';\n\n  if (fileId) {\n    const cleanBase = base.replace(/\\/$/, '');\n    finalUrl = `${cleanBase}/webhook/file-proxy?file_id=${fileId}`;\n  }\n}\n\nreturn {\n  json: {\n    ...input,\n    original_asset_url: originalUrl,\n    final_asset_url: finalUrl\n  }\n};\n"
      },
      "id": "ca7a335d-1a1c-437e-a925-deb4ca737fa2",
      "name": "Code: Normalize URL (Drive -> Proxy)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        704
      ]
    }
